<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 차체 치수 (nav2 footprint 와 같은 실측값).
       body_height 는 지면에서 차체 윗면까지다. base_link 가 지면에 있으므로
       차체 상자는 base_link 위로 그대로 쌓인다. -->
  <xacro:property name="body_length" value="1.62"/>
  <xacro:property name="body_width"  value="0.952"/>
  <xacro:property name="body_height" value="0.60"/>

  <!-- 라이다 중심 프레임 (base_link=지면 기준).
       front/rear 의 중점이고, z 0.32 는 지면 위 라이다 평면 높이다. -->
  <xacro:property name="livox_frame_xyz" value="0.0485 0.005 0.32"/>

  <!-- Front라이다 장착 위치 (livox_frame 기준).-->
  <xacro:property name="front_xyz" value="0.6485 0.345 0.0825"/>
  <xacro:property name="front_rpy" value="0.005567 -0.010252 ${pi/2}"/>

  <!-- Rear라이다 장착 위치 (livox_frame 기준).-->
  <xacro:property name="rear_xyz"  value="-0.6485 -0.345 0"/>
  <xacro:property name="rear_rpy"  value="0 0 ${-pi/2}"/>

  <!-- Top 라이다 장착 (livox_frame z 0.32 기준).
       주행모드 지면 위 1.3359 m (rel 1.0159), 도킹모드 1.9346 m (rel 1.6146).
       URDF 조인트에는 주행모드(top_xyz/top_rpy)가 들어가고, /docking 토픽이
       true 면 top_tf_switcher.py 가 도킹모드(top_dock_*)로 TF 를 바꿔 낸다.
   -->
  <xacro:property name="top_xyz"      value="-0.0375 -0.28 1.0159"/>
  <xacro:property name="top_rpy"      value="-1.589567 0.009866 ${pi}"/>
  <xacro:property name="top_dock_xyz" value="-0.0375 -0.28 1.6146"/>
  <xacro:property name="top_dock_rpy" value="-1.586673 0.009306 ${pi}"/>


  <!-- MID-360 몸통 원점 -> 내부 IMU (Livox 공장값) -->
  <xacro:property name="imu_xyz"   value="0.011 0.02329 -0.04412"/>

</robot>
