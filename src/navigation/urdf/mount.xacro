<?xml version="1.0"?>
<!--
  장착값 한 곳. vehicle.urdf.xacro 가 읽는다.
  병합 노드는 이 값을 TF 로 그대로 받아 쓴다(사본 없음). 값을 고치면
  tools/check_frames.py 로 fast_lio 설정과의 정합을,
  tools/check_lidar_overlap.py 로 실물과의 정합을 확인할 것.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 차체 치수 (nav2 footprint 와 같은 실측값).
       body_height 는 지면에서 차체 윗면까지다. base_link 가 지면에 있으므로
       차체 상자는 base_link 위로 그대로 쌓인다. -->
  <xacro:property name="body_length" value="1.62"/>
  <xacro:property name="body_width"  value="0.952"/>
  <xacro:property name="body_height" value="0.60"/>

  <!-- 라이다 중심 프레임 (base_link=지면 기준).
       front/rear 의 중점이고, z 0.32 는 지면 위 라이다 평면 높이다. -->
  <xacro:property name="livox_frame_xyz" value="0.0485 0.005 0.32"/>

  <!-- 라이다 장착 (livox_frame 기준). front/rear 는 정의상 정확히 원점대칭이다. -->
  <xacro:property name="front_xyz" value="0.6485 0.345 0"/>
  <xacro:property name="front_rpy" value="0 0 ${pi/2}"/>

  <xacro:property name="rear_xyz"  value="-0.6485 -0.345 0"/>
  <xacro:property name="rear_rpy"  value="0 0 ${-pi/2}"/>

  <!-- MID-360 장착 (livox_frame 기준). front/rear 는 정의상 정확히 원점대칭이다. -->
  <xacro:property name="top_xyz"   value="-0.0375 -0.28 0.1073"/>
  <xacro:property name="top_rpy"   value="${-pi/2} 0 ${pi}"/>

  <!-- MID-360 몸통 원점 -> 내부 IMU (Livox 공장값) -->
  <xacro:property name="imu_xyz"   value="0.011 0.02329 -0.04412"/>

</robot>
