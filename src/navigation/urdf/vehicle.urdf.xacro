<?xml version="1.0"?>
<!--
  차량과 센서 형상. 내비게이션이 쓰는 2D 체인 아래에 붙는다.

    map ── odom ── base_link ── livox_frame ─┬─ livox_top ── imu_link
                     (지면)     (라이다 중심)  ├─ livox_front
                                              └─ livox_rear

  map->odom, odom->base_link 은 tf_2d.py 가 낸다. base_link 는 이 URDF 의
  루트이므로 여기서는 발행하지 않는다(부모가 둘이 되면 TF 가 깨진다).

  base_link 는 tf_2d.py 의 planarize() 가 z 를 0 으로 눌러 만드는 평면 프레임이고,
  동시에 지면 프레임이다. 즉 base_link 기준 z 는 곧 지면 위 높이이고, 라이다
  extrinsic / 슬라이스 z / costmap 장애물 높이가 전부 이 하나의 원점을 쓴다.
  (예전에는 base_link 를 지면보다 0.5m 위에 두고 base_footprint 를 따로 뒀는데,
   기준이 둘로 갈려 파라미터마다 -0.5 보정이 붙었다. 2026-08-27 에 합쳤다.)

  주의: 사전지도 PCD 의 바닥면은 map z ≈ -0.385 에 있다. planarize() 가 z=0 을
  강제하므로 RViz 에서 3D prior map 을 겹쳐 보면 차량이 지도 바닥보다 그만큼
  떠 보인다. 표시상의 차이일 뿐 x/y/yaw 와 costmap 높이 필터에는 영향이 없다.

  livox_frame 은 세 라이다를 묶는 중심 프레임으로, front/rear 의 중점이다.
  (드라이버가 클라우드에 찍는 frame_id 는 livox_top/front/rear 이고
   livox_frame 은 쓰지 않는다 - multi_MID360_config.json 참조)

  FAST-LIO 의 camera_init / body 는 측위 엔진 내부 프레임이라 TF 에 올리지
  않는다(debug_tf 로만 켠다). body -> base_link extrinsic 은
  fast_lio_localization/config/mid360.yaml 의 ref_from_body_* 가 든다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vehicle">
  <xacro:include filename="mount.xacro"/>

  <material name="grey"><color rgba="0.4 0.4 0.4 0.5"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>

  <xacro:macro name="mid360" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.032" length="0.065"/></geometry>
        <material name="orange"/>
      </visual>
    </link>
    <joint name="livox_frame_to_${name}" type="fixed">
      <parent link="livox_frame"/>
      <child  link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- tf_2d.py 가 내보내는 평면화된 차량 프레임이자 지면 프레임.
       차체와 센서를 매다는 자리이고, 여기 기준 z = 지면 위 높이다. -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <origin xyz="0 0 ${body_height/2}"/>
      <material name="grey"/>
    </visual>
  </link>

  <!-- 세 라이다를 묶는 중심 프레임. front/rear 의 중점이다. -->
  <link name="livox_frame"/>
  <joint name="base_link_to_livox_frame" type="fixed">
    <parent link="base_link"/><child link="livox_frame"/>
    <origin xyz="${livox_frame_xyz}" rpy="0 0 0"/>
  </joint>

  <xacro:mid360 name="livox_top"   xyz="${top_xyz}"   rpy="${top_rpy}"/>
  <xacro:mid360 name="livox_front" xyz="${front_xyz}" rpy="${front_rpy}"/>
  <xacro:mid360 name="livox_rear"  xyz="${rear_xyz}"  rpy="${rear_rpy}"/>

  <!-- 상단 라이다 내장 IMU. FAST-LIO 의 body 프레임이 가리키는 물리적 지점과
       같은 곳이지만, 이쪽은 URDF 가 모델링한 위치다. -->
  <link name="imu_link"/>
  <joint name="livox_top_to_imu" type="fixed">
    <parent link="livox_top"/><child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

</robot>
