<?xml version="1.0"?>
<!--
  차량 + 센서 장착 형상. TF 의 유일한 출처.

  장착값 출처: rbio TransferRobot LidarMountCalibration.cpp defaultMountTransform()
  회전 합성이 yaw*pitch*roll (= Rz*Ry*Rx) 라 URDF rpy 와 같은 관례다.

  트리가 base_footprint 가 아니라 body 에서 시작하는 이유:
    FAST-LIO 의 "body" 는 차량 기준점이 아니라 IMU 프레임이다.
    (publish_frame_body 가 RGBpointBodyLidarToIMU 로 변환해서 body 로 stamp)
    FAST-LIO 가 camera_init->body 를 이미 내보내므로 body 가 이 URDF 의 루트가
    되어야 하고, 차량 기준점은 그 아래에 매달린다. TF 는 프레임당 부모가
    하나뿐이라 반대로는 못 짠다.

    map ─┬─ camera_init ── body(=IMU, livox_top 내부)
         │                  └─ base_footprint ─┬─ livox_frame
         │                                     ├─ livox_top
         │                                     ├─ livox_front
         │                                     └─ livox_rear
         └─ odom ── base_link      <- tf_2d.py 가 base_footprint 를 평면화한 것
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vehicle">

  <!-- ===== 차체 치수 (nav2 footprint 와 같은 실측값) ===== -->
  <xacro:property name="body_length" value="1.62"/>
  <xacro:property name="body_width"  value="0.952"/>
  <xacro:property name="body_height" value="0.60"/>

  <!-- ===== 라이다 장착 (base_footprint 기준) =====
       front/rear 는 예전 msg_Multi_launch.py 의 static TF 값이다. 이 값들은
       base_footprint 에 대해 원점대칭이다(합이 xy 로 (0.097, 0.01) ~ 0).
         front + rear = (0.097, 0.01)   yaw 는 +90 / -90 으로 180도 차이
       rbio 값은 중점이 (-0.34, -0.28) 로 치우쳐 있고 rear/top 의 y=-0.56 이
       차폭(0.952) 밖으로 나가서 쓰지 않는다. -->
  <xacro:property name="front_xyz" value="0.697 0.35 -0.18"/>
  <xacro:property name="front_rpy" value="0 0 ${pi/2}"/>

  <xacro:property name="rear_xyz"  value="-0.6 -0.34 -0.18"/>
  <xacro:property name="rear_rpy"  value="0 0 ${-pi/2}"/>

  <!-- top: 예전 static TF 에는 이 라이다가 없었다. rbio 값 (0, -0.56, 1.40) 을
       두 기준의 평균 오프셋 (-0.3885, -0.285, 0.5535) 만큼 되돌린 추정치다.
       front/rear 각각으로 구한 오프셋이 y 에서 13cm 어긋나므로 이 값의
       불확실도는 대략 +-(0.01, 0.065, 0.025) 다. 실측하면 여기만 고치면 된다.
       회전은 실측으로 확인된 값(roll -90, yaw 180). -->
  <xacro:property name="top_xyz"   value="0.3885 -0.275 0.8465"/>
  <xacro:property name="top_rpy"   value="${-pi/2} 0 ${pi}"/>

  <!-- body(=top 라이다 내부 IMU) 에서 본 base_footprint.
       계산: inverse( T(base_footprint<-top) * T(top<-IMU) )
       T(top<-IMU) 는 MID-360 공장값 (0.011, 0.02329, -0.04412), 회전 없음.
       top_xyz 를 고치면 이 값과 fast_lio*/config/mid360.yaml 의 extrinsic_T 를
       같이 다시 계산해야 한다. -->
  <xacro:property name="bf_from_body_xyz" value="0.3775 0.82321 -0.23088"/>
  <xacro:property name="bf_from_body_rpy" value="${-pi/2} 0 ${-pi}"/>

  <material name="grey"><color rgba="0.4 0.4 0.4 0.5"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>

  <xacro:macro name="mid360" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.032" length="0.065"/></geometry>
        <material name="orange"/>
      </visual>
    </link>
    <joint name="base_footprint_to_${name}" type="fixed">
      <parent link="base_footprint"/>
      <child  link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ===== 루트: FAST-LIO 가 내보내는 IMU 프레임 ===== -->
  <link name="body"/>

  <!-- 같은 지점에 대한 별칭. IMU 메시지 시각화용. -->
  <link name="imu_link"/>
  <joint name="body_to_imu_link" type="fixed">
    <parent link="body"/><child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 차량 기준점 (지면) ===== -->
  <link name="base_footprint">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <origin xyz="0 0 ${body_height/2}"/>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="body_to_base_footprint" type="fixed">
    <parent link="body"/><child link="base_footprint"/>
    <origin xyz="${bf_from_body_xyz}" rpy="${bf_from_body_rpy}"/>
  </joint>

  <!-- 드라이버가 원시 클라우드 header 에 찍는 이름. 병합 전이라 기하학적
       의미는 없고, RViz 가 프레임을 못 찾는 것만 막아준다. -->
  <link name="livox_frame"/>
  <joint name="base_footprint_to_livox_frame" type="fixed">
    <parent link="base_footprint"/><child link="livox_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 라이다 3대 ===== -->
  <xacro:mid360 name="livox_top"   xyz="${top_xyz}"   rpy="${top_rpy}"/>
  <xacro:mid360 name="livox_front" xyz="${front_xyz}" rpy="${front_rpy}"/>
  <xacro:mid360 name="livox_rear"  xyz="${rear_xyz}"  rpy="${rear_rpy}"/>

</robot>
