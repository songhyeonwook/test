<?xml version="1.0"?>
<!--
  FAST-LIO 내부 배관. 사용자가 볼 일은 없다.

  FAST-LIO 는 camera_init -> body 를 직접 발행하고, 여기서 body 는 차량 기준점이
  아니라 IMU 프레임이다(publish_frame_body 가 포인트를 IMU 좌표로 옮겨 stamp).
  tf_2d.py 가 이걸 평면화해서 map->odom->base_link 를 만드는데, body 는 상단
  라이다와 함께 누워 있어서 그대로 평면화하면 yaw 가 엉킨다.

  그래서 body 아래에 차량 정렬된 기준 프레임 하나를 두고 tf_2d 가 그걸 쓴다.

    map ── camera_init ── body ── fastlio_ref      <- tf_2d.py 의 평면화 대상

  차량 모델과 센서는 여기 붙지 않는다. vehicle.urdf.xacro 를 볼 것.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fastlio_ref">
  <xacro:include filename="mount.xacro"/>

  <link name="body"/>
  <link name="fastlio_ref"/>
  <joint name="body_to_fastlio_ref" type="fixed">
    <parent link="body"/><child link="fastlio_ref"/>
    <origin xyz="${ref_from_body_xyz}" rpy="${ref_from_body_rpy}"/>
  </joint>
</robot>
